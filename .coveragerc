[run]
source =
    src
    scripts
omit =
    pages/*
    app.py
    components/*
    src/models/train_all_crops.py
    scripts/train_all_crops.py
    src/pipelines/spark/silver_pipeline.py
    src/pipelines/spark/gold_batch_job.py
    src/pipelines/spark/spark_session.py
    tests/*

[report]
show_missing = True
precision = 1
exclude_lines =
    pragma: no cover
    def __repr__
    if __name__ == .__main__.:
    raise AssertionError
    raise NotImplementedError
    if TYPE_CHECKING:
